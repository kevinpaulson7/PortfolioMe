@page "/"
@using Portfolio.Models
@inject IJSRuntime JS

<!-- Hero Section (Photo Removed, Centered) -->
<section id="home" class="min-h-[70vh] flex flex-col justify-center items-center pt-20 px-4 text-center">
    <div class="max-w-4xl mx-auto" data-aos="fade-up">
        <h1 class="text-4xl md:text-6xl font-bold text-white mb-6">
            Software Developer <br />
            <span class="text-blue-500 bg-clip-text">C# / .NET & Python</span>
        </h1>
        <p class="text-lg md:text-xl text-slate-400 mb-10 leading-relaxed max-w-3xl mx-auto">
            I am a Software Developer with experience building enterprise business applications using C#, .NET, and SQL Server. I specialize in WPF/WinForms consoles, REST API integration, workflow automation, and building robust backend scheduling systems.
        </p>
        <div class="flex gap-4 justify-center">
            <a href="#experience" class="bg-blue-600 hover:bg-blue-500 text-white px-8 py-3 rounded-lg font-medium transition-all shadow-lg shadow-blue-500/30">
                View Experience
            </a>
            <a href="#projects" class="border border-slate-600 hover:border-slate-400 text-white px-8 py-3 rounded-lg font-medium transition-all">
                View Projects
            </a>
        </div>
    </div>
</section>

<!-- Experience Section (New) -->
<section id="experience" class="py-20 px-4 bg-slate-800/30 border-y border-slate-800">
    <div class="max-w-7xl mx-auto">
        <h2 class="text-3xl font-bold text-center text-white mb-12" data-aos="fade-up">Professional Experience</h2>

        <!-- Horizontal Grid layout for cards -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            @foreach (var exp in experiences)
            {
                <!-- Card with live glowing hover effect -->
                <div data-aos="fade-up" class="group bg-slate-800/80 rounded-xl p-6 border border-slate-700 transition-all duration-300 hover:-translate-y-2 hover:border-blue-400 hover:shadow-[0_0_30px_rgba(59,130,246,0.3)] hover:bg-slate-800 flex flex-col">

                    <div class="flex items-center gap-4 mb-6 border-b border-slate-700 pb-4">
                        <!-- Logo Placeholder -->
                        <div class="w-16 h-16 bg-slate-200 rounded p-1 flex-shrink-0">
                            <img src="@exp.LogoPath" alt="@exp.CompanyName Logo" class="w-full h-full object-contain" />
                        </div>
                        <div>
                            <h3 class="text-xl font-bold text-white group-hover:text-blue-400 transition-colors">@exp.CompanyName</h3>
                            <p class="text-blue-400 text-sm font-semibold">@exp.Role</p>
                            <p class="text-slate-400 text-xs mt-1"><i class="far fa-calendar-alt mr-1"></i> @exp.Period</p>
                        </div>
                    </div>

                    <ul class="text-slate-300 text-sm space-y-3 flex-grow">
                        @foreach (var point in exp.Highlights)
                        {
                            <li class="flex items-start">
                                <span class="text-blue-500 mr-2 mt-1">•</span>
                                <span class="leading-relaxed">@point</span>
                            </li>
                        }
                    </ul>
                </div>
            }
        </div>
    </div>
</section>

<!-- Projects Section -->
<section id="projects" class="py-20 px-4">
    <div class="max-w-7xl mx-auto">
        <h2 class="text-3xl font-bold text-center text-white mb-12" data-aos="fade-up">Featured Projects</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            @foreach (var project in projects)
            {
                <!-- Applied similar glowing hover effect to project cards -->
                <div data-aos="fade-up" class="bg-slate-800/80 rounded-xl overflow-hidden border border-slate-700 transition-all duration-300 hover:-translate-y-2 hover:border-blue-400 hover:shadow-[0_0_30px_rgba(59,130,246,0.3)] flex flex-col">
                    <div class="relative pt-[70%]">
                        <video controls class="absolute top-0 left-0 w-full h-full object-cover bg-black">
                            <source src="@project.VideoPath" type="video/mp4">
                        </video>
                    </div>
                    <div class="p-6 flex flex-col flex-grow">
                        <h3 class="text-xl font-bold text-white mb-2">@project.Title</h3>
                        <p class="text-slate-400 text-sm mb-4 flex-grow">@project.Description</p>

                        <div class="flex flex-wrap gap-2 mb-6 mt-auto">
                            @foreach (var tech in project.TechStack)
                            {
                                <span class="bg-slate-700/50 text-blue-300 text-xs px-2 py-1 rounded border border-slate-600">@tech</span>
                            }
                        </div>

                        @if (!string.IsNullOrEmpty(project.GithubUrl))
                        {
                            <a href="@project.GithubUrl" target="_blank" class="block w-full text-center border border-slate-600 hover:border-blue-400 hover:text-blue-400 text-white px-4 py-2 rounded transition-colors">
                                <i class="fab fa-github mr-2"></i> View Code
                            </a>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</section>


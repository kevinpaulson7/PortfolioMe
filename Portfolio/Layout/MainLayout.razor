@inherits LayoutComponentBase

<div class="min-h-screen bg-transparent text-slate-200 flex flex-col font-sans">

    <!-- Navbar -->
    <header class="sticky top-0 z-50 bg-slate-900/80 backdrop-blur-md border-b border-slate-800">
        <div class="max-w-6xl mx-auto px-4 py-4 flex justify-between items-center">
            <h2 class="text-2xl font-bold text-white tracking-tight">Kevin Paulson</h2>
            <nav class="hidden md:flex gap-6">
                <a href="#home" class="hover:text-blue-400 transition-colors">Home</a>
                <a href="#skills" class="hover:text-blue-400 transition-colors">Skills</a>
                <a href="#experience" class="hover:text-blue-400 transition-colors">Experience</a>
                <a href="#projects" class="hover:text-blue-400 transition-colors">Projects</a>
                <a href="#resume" class="hover:text-blue-400 transition-colors">Resume</a>
                <a href="#contact" class="hover:text-blue-400 transition-colors">Contact</a>
            </nav>
        </div>
    </header>

    <!-- Main Content -->
    <main class="flex-grow">
        @Body
    </main>

    <!-- Footer -->
    <footer class="bg-slate-950 py-8 border-t border-slate-800">
        <div class="max-w-6xl mx-auto px-4 flex flex-col items-center gap-4">
            <div class="flex gap-6">
                <a href="https://github.com/kevinpaulson7" target="_blank" class="text-slate-400 hover:text-white text-2xl transition"><i class="fab fa-github"></i></a>
                <a href="https://www.linkedin.com/in/kevin-paulson-272030252/" target="_blank" class="text-slate-400 hover:text-blue-500 text-2xl transition"><i class="fab fa-linkedin"></i></a>
                <a href="https://www.instagram.com/_kev1npaulson_/" target="_blank" class="text-slate-400 hover:text-pink-500 text-2xl transition"><i class="fab fa-instagram"></i></a>
            </div>
        </div>
    </footer>

</div>